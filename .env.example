# Copie para .env e preencha. Usado só em desenvolvimento local (Pages Functions via wrangler).
# Em produção, configure como secret no Cloudflare Pages: BRAPI_TOKEN
BRAPI_TOKEN=
# Cloudflare Pages secret em produção; localmente vai em .dev.vars (não commitado)
TURNSTILE_SECRET_KEY=
# Cloudflare Pages secret em produção; localmente vai em .dev.vars (não commitado)
SESSION_HMAC_KEY=
# Pública (não é segredo); em produção, variável de build no Cloudflare Pages.
VITE_TURNSTILE_SITE_KEY=
